# ===================================================================
# Supabase PostgreSQL & Auth Credentials
# ===================================================================
# Obtain these from your Supabase project dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required
# for user authentication (Sign Up, Log In, Log Out) and Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for administrative database tasks (server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
